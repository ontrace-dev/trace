# --- core -------------------------------------------------------------
DATABASE_URL=postgres://trace:trace@localhost:5432/trace
# Where users open the app. In dev this is the Vite server (it proxies /api to the API).
APP_URL=http://localhost:5173
# Public URL of the API server (widget script, webhooks, Slack request URLs).
PUBLIC_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# --- AI ---------------------------------------------------------------
# Without a key trace runs an offline heuristic agent (triage + grounded drafts, never auto-sends).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Allow MCP servers that run as local commands (stdio) on this host. Defaults to true in dev, false in production.
# MCP_ALLOW_STDIO=true

# --- knowledge search ----------------------------------------------------
# Local multilingual embeddings (no API key; ~120 MB model downloaded to .data/models on first use).
# Set EMBEDDINGS=off for keyword-only search.
EMBEDDINGS=on
EMBEDDINGS_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# --- email ------------------------------------------------------------
# Outbound replies. Defaults to Mailpit from docker-compose (UI on http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="trace <no-reply@trace.local>"
# Built-in inbound SMTP server for support@ mail (0 disables it).
INBOUND_SMTP_PORT=2525
INBOUND_DOMAIN=inbound.trace.local

# --- Slack (optional: only needed for the "Add to Slack" OAuth flow / HTTP events) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- social login (optional) -------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID). Tenant "common" allows work and personal accounts; a tenant id allows one tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# GitLab; set GITLAB_ISSUER for a self-hosted instance (https://gitlab.example.com).
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=

# --- workspace SSO (optional) ----------------------------------------------
# Workspace admins add OIDC/SAML providers in Settings → Single sign-on. Only public https IdPs are
# reachable by default; list internal IdP origins here (comma-separated).
SSO_TRUSTED_ORIGINS=
