# Production settings for docker-compose.prod.yml — copy to .env on the server.

# Your domain (DNS A record → this server). HTTPS is automatic.
DOMAIN=support.example.com

# Generate both with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Optional: the AI agent (without it trace uses local heuristics).
ANTHROPIC_API_KEY=

# Outbound email for replies and invites, e.g. smtp://user:pass@smtp.postmarkapp.com:587
SMTP_URL=
MAIL_FROM="Support <support@example.com>"

# Inbound email: forwarding addresses are <token>@INBOUND_DOMAIN. Set INBOUND_SMTP_PORT=25 and an MX record
# for INBOUND_DOMAIN pointing at this server to receive mail directly.
INBOUND_DOMAIN=
INBOUND_SMTP_PORT=2525

# Create the "northwind" demo workspace on first boot (demo@trace.dev / password).
SEED_DEMO=false

# Public test instance: "Try the demo" button, protected demo accounts, workspace rebuilt every 24h.
DEMO_MODE=false
DEMO_RESET_HOURS=24
