{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "vp pack",
    "start": "node --env-file-if-exists=../../.env dist/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-cli.ts",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/sso": "catalog:",
    "@hono/node-server": "^2.1.3",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "catalog:",
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.2.0",
    "better-auth": "^1.7.7",
    "discord.js": "catalog:",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "mailparser": "^3.9.36",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.0.16",
    "postgres": "^3.4.9",
    "smtp-server": "^3.19.17",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
